pipeline {
    agent any

    environment {
        // Enforce sequential layer pushing to prevent your server from running out of memory
        DOCKER_MAX_CONCURRENT_UPLOADS = '1'
    }

    stages {
        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                script {
                    withDockerRegistry([credentialsId: 'dockerhub-credentials', url: '']) {
                        // Build using the explicit build ID tag
                        sh "docker build -t iamvyshnav/nodejs-app:${env.BUILD_ID} ."
                        sh "docker push iamvyshnav/nodejs-app:${env.BUILD_ID}"
                        
                        // Tag and push latest sequentially
                        sh "docker tag iamvyshnav/nodejs-app:${env.BUILD_ID} iamvyshnav/nodejs-app:latest"
                        sh "docker push iamvyshnav/nodejs-app:latest"
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Update the deployment file with the fresh build ID automatically
                    sh "sed -i 's|image: iamvyshnav/nodejs-app:.*|image: iamvyshnav/nodejs-app:${env.BUILD_ID}|g' deployment.yaml"
                    
                    // Apply manifests directly to Minikube
                    sh 'kubectl apply -f deployment.yaml'
                    sh 'kubectl apply -f service.yaml'
                }
            }
        }
    }
}

